# Copy to .env and replace every REPLACE_ME value; never commit .env.
# docker compose reads .env automatically. For ./mvnw spring-boot:run, export
# the RELEASEFLOW_* values and point RELEASEFLOW_DB_URL at your database.

# PostgreSQL used by docker-compose.demo.yml.
RELEASEFLOW_DB_NAME=releaseflow
RELEASEFLOW_DB_USERNAME=releaseflow
RELEASEFLOW_DB_PASSWORD=REPLACE_ME

# Required: Base64 encoding of exactly 32 bytes; encrypts webhook secrets.
# Generate with: openssl rand -base64 32
RELEASEFLOW_CREDENTIAL_MASTER_KEY=REPLACE_ME

# Host loopback port for the application.
RELEASEFLOW_HTTP_PORT=8080

# Set true whenever the application is served over HTTPS.
RELEASEFLOW_SESSION_COOKIE_SECURE=false

# Sensitive-path patterns are not forwarded by docker-compose.demo.yml: an empty
# value would stop the application. To replace the default list, add
# RELEASEFLOW_SENSITIVE_PATHS to the app environment in the Compose file.

# Review-signal thresholds are not forwarded by docker-compose.demo.yml, and an
# empty value would stop the application. The defaults are a context score of 60
# and a duplicate similarity of 0.82; to change them, add
# RELEASEFLOW_CONTEXT_THRESHOLD or RELEASEFLOW_DUPLICATE_THRESHOLD to the app
# environment in the Compose file.

# Optional AI classification: openai, anthropic, or deepseek. Leave empty to
# classify with the rules only. The chosen provider needs its key and model;
# there is no default model (for example claude-opus-5 for anthropic).
RELEASEFLOW_AI_PROVIDER=
RELEASEFLOW_OPENAI_API_KEY=
RELEASEFLOW_OPENAI_MODEL=
RELEASEFLOW_ANTHROPIC_API_KEY=
RELEASEFLOW_ANTHROPIC_MODEL=
RELEASEFLOW_DEEPSEEK_API_KEY=
RELEASEFLOW_DEEPSEEK_MODEL=

# Optional translation of release notes into other languages: disabled or deepl.
# DeepL needs its key; a key ending in :fx uses the free API. Leave the base URL
# empty to choose the host from the key.
RELEASEFLOW_TRANSLATION_PROVIDER=disabled
RELEASEFLOW_DEEPL_API_KEY=
RELEASEFLOW_DEEPL_BASE_URL=

# Optional email automation. Without an SMTP host and a sender address, an
# automation rule with an email action cannot be enabled; every other kind of
# action still works. Never commit a real password.
RELEASEFLOW_SMTP_HOST=
RELEASEFLOW_SMTP_PORT=587
RELEASEFLOW_SMTP_USERNAME=
RELEASEFLOW_SMTP_PASSWORD=
RELEASEFLOW_SMTP_AUTH=false
RELEASEFLOW_SMTP_STARTTLS=false
RELEASEFLOW_AUTOMATION_EMAIL_FROM=

# Notion and Confluence actions need nothing here: the integration token or API token
# is entered per action in the UI, and both providers' defaults work as they are.

# The address this deployment is reached at. Every public changelog link is built from
# it. Leave the changelog domain empty unless you have wildcard DNS and TLS for it, in
# which case each Organization is also served at {slug}.{domain}.
RELEASEFLOW_PUBLIC_BASE_URL=http://localhost:8080
RELEASEFLOW_PUBLIC_CHANGELOG_BASE_DOMAIN=
