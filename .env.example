# Copy to .env and replace every REPLACE_ME value; never commit .env.
# docker compose reads .env automatically. For ./mvnw spring-boot:run, export
# the RELEASEFLOW_* values and point RELEASEFLOW_DB_URL at your database.

# PostgreSQL used by docker-compose.demo.yml.
RELEASEFLOW_DB_NAME=releaseflow
RELEASEFLOW_DB_USERNAME=releaseflow
RELEASEFLOW_DB_PASSWORD=REPLACE_ME

# Required: Base64 encoding of exactly 32 bytes; encrypts webhook secrets.
# Generate with: openssl rand -base64 32
RELEASEFLOW_CREDENTIAL_MASTER_KEY=REPLACE_ME

# Host loopback port for the application.
RELEASEFLOW_HTTP_PORT=8080

# Set true whenever the application is served over HTTPS.
RELEASEFLOW_SESSION_COOKIE_SECURE=false

# Sensitive-path patterns are not forwarded by docker-compose.demo.yml: an empty
# value would stop the application. To replace the default list, add
# RELEASEFLOW_SENSITIVE_PATHS to the app environment in the Compose file.

# Optional OpenAI suggestions for Unknown changes; set both or neither.
RELEASEFLOW_OPENAI_API_KEY=
RELEASEFLOW_OPENAI_MODEL=
